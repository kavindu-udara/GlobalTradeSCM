<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.globaltrade.scms</groupId>
    <artifactId>globaltrade-scms-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>GlobalTrade Supply Chain Management System Parent</name>

    <modules>
        <module>app/scms-common</module>
        <module>app/scms-ejb-api</module>
        <module>app/scms-ejb-core</module>
        <module>app/scms-web</module>
        <module>app/scms-ear</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jakartaee.version>10.0.0</jakartaee.version>
        <postgresql.version>42.7.3</postgresql.version>

        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.ejb.plugin.version>3.2.1</maven.ejb.plugin.version>
        <maven.war.plugin.version>3.4.0</maven.war.plugin.version>
        <maven.ear.plugin.version>3.3.0</maven.ear.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.globaltrade.scms</groupId>
                <artifactId>scms-common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.globaltrade.scms</groupId>
                <artifactId>scms-ejb-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.globaltrade.scms</groupId>
                <artifactId>scms-ejb-core</artifactId>
                <version>${project.version}</version>
                <type>ejb</type>
            </dependency>

            <dependency>
                <groupId>com.globaltrade.scms</groupId>
                <artifactId>scms-web</artifactId>
                <version>${project.version}</version>
                <type>war</type>
            </dependency>

            <!-- Jakarta EE API -->
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-api</artifactId>
                <version>${jakartaee.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- PostgreSQL Driver -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
                <scope>runtime</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-ejb-plugin</artifactId>
                    <version>${maven.ejb.plugin.version}</version>
                    <configuration>
                        <ejbVersion>3.2</ejbVersion>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>${maven.war.plugin.version}</version>
                    <configuration>
                        <failOnMissingWebXml>false</failOnMissingWebXml>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-ear-plugin</artifactId>
                    <version>${maven.ear.plugin.version}</version>
                    <configuration>
                        <displayName>GlobalTrade SCMS</displayName>
                        <defaultLibBundleDir>lib</defaultLibBundleDir>
                        <generateApplicationXml>true</generateApplicationXml>
                        <modules>
                            <webModule>
                                <groupId>com.globaltrade.scms</groupId>
                                <artifactId>scms-web</artifactId>
                                <contextRoot>/scms</contextRoot>
                            </webModule>
                        </modules>
                    </configuration>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

</project>
